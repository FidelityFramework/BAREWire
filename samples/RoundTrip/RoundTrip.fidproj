# The native gate (docs/12 §5): a reachable program over every shared tier,
# compiled by Composer to a binary and run. Its transcript is compared with
# the .NET test gate's values for the same inputs; agreement is the
# cross-substrate byte-identity claim made testable (Readiness Audit §4 step 4).
#
# Re-run with tests/native_gate.py on the compiler under test. A historical
# pass on another snapshot does not establish acceptance of the current tree.

[package]
name = "RoundTrip"
version = "0.1.0"
description = "BAREWire native gate"

[compilation]
target = "cpu"

[dependencies]
platform = { path = "/home/hhh/repos/Fidelity.Platform/Profiles/Linux_x86_64_Default/Fidelity.Platform.fidproj" }
barewire = { path = "../../src/BAREWire.fidproj" }

[build]
sources = [
    "Main.clef"
]
output = "roundtrip"
output_kind = "console"
