<Project Sdk="Microsoft.NET.Sdk">

  <!-- The .NET test gate: a zero-dependency console runner. Golden-frame vectors
       (byte-exact BARE encodings), envelope round trips, validator verdicts, and
       platform-description observers. Run with dotnet run on this project;
       a non-zero exit is a failure. The transcript it prints for the RoundTrip sample's
       inputs is compared with the native sample's output (docs/12 §5). -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>FS0051</NoWarn>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Harness.fs" />
    <Compile Include="EncodingTests.fs" />
    <Compile Include="FramingTests.fs" />
    <Compile Include="SchemaTests.fs" />
    <Compile Include="HardwareTests.fs" />
    <Compile Include="MemoryTests.fs" />
    <Compile Include="PlatformTests.fs" />
    <Compile Include="StaticStorageTests.fs" />
    <Compile Include="DispatchRegionTests.fs" />
    <Compile Include="TranscriptTests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../src/BAREWire.fsproj" />
  </ItemGroup>

</Project>
